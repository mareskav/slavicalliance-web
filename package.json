{
  "name": "slavicalliance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "npm --workspace apps/site run dev",
    "build:site": "npm --workspace apps/site run build",
    "preview:site": "npm --workspace apps/site run preview",
    "deploy:site": "npm --workspace apps/site run deploy",
    "dev:results": "npm --workspace apps/results run dev",
    "build:results": "npm --workspace apps/results run build",
    "preview:results": "npm --workspace apps/results run preview",
    "deploy:results": "npm --workspace apps/results run deploy",
    "upload:results": "npm --workspace apps/results run upload",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:site && npm run test:results",
    "test:site": "npm --workspace apps/site run test",
    "test:results": "npm --workspace apps/results run test",
    "test:e2e": "npm --workspace apps/site run test:e2e"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "vitest": "^3.2.4"
  }
}
