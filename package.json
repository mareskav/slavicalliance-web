{
  "name": "slavicalliance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "npm --workspace apps/site run dev",
    "build:site": "npm --workspace apps/site run build",
    "preview:site": "npm --workspace apps/site run preview",
    "deploy:site": "npm --workspace apps/site run deploy",
    "publish:results": "node scripts/publish-results-snapshots.mjs",
    "publish:results:dry": "node scripts/publish-results-snapshots.mjs --dry-run",
    "serve:snapshots": "node scripts/serve-snapshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:site && npm run test:data",
    "test:site": "npm --workspace apps/site run test",
    "test:data": "npm --workspace packages/results-data run test",
    "test:e2e": "npm --workspace apps/site run test:e2e"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "vitest": "^3.2.4"
  }
}
