# Copy to .env.local for local development, or set these variables in Cloudflare.
#
# Next.js loads env files from apps/site; scripts/dev.mjs also reads this root .env.local.

# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slavicalliance?schema=public"

# Neon PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB_NAME?sslmode=require"

DATABASE_URL=""

# Low-privilege connection string (the sa_web_rw role) used only by the
# manual-results write API (apps/site/functions). Separate from DATABASE_URL so a
# bug in that route can't reach the scraper-owned tables. See
# docs/plans/manual-quiz-results.md and packages/results-data/sql/.
DATABASE_URL_RW=""

# Where the browser loads the results JSON snapshots from. Production default
# is https://data.slavicalliance.cz. Locally: `npm run publish:results:dry`
# then `npm run serve:snapshots` and point this at http://localhost:4010.
NEXT_PUBLIC_RESULTS_DATA_URL=""

# apps/site content is stored in a Cloudflare R2 binding named CONTENT_BUCKET.
# The binding is configured in apps/site/wrangler.jsonc, not in this file.
#
# /admin is intentionally outside the current deploy scope. Only set these when
# enabling the admin Functions routes.
ADMIN_PASSWORD=""

SESSION_SECRET=""
